# GitHub Actions 所需的 Secrets
# 配置位置: Settings > Secrets and variables > Actions
# ⚠️ 这是示例文件，不要在这里填写真实值！

# Unsplash API 密钥（从 https://unsplash.com/developers 获取）
UNSPLASH_ACCESS_KEY=your_access_key_here

# Unsplash 用户名
UNSPLASH_USERNAME=siriusharrison

# 飞书机器人 Webhook 地址
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx
