# GitHub Actions 所需的 Secrets
# 配置位置: https://github.com/YOUR_USERNAME/SIRIUS-ATEAM/settings/secrets/actions
# ⚠️ 这是示例文件，不要在这里填写真实值！

# ========== 摄影师 Agent (agents/image-guardian) ==========
# Unsplash API 密钥
# 获取方式: https://unsplash.com/oauth/applications → 复制 "Access Key"
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Unsplash 用户名（默认值: siriusharrison）
UNSPLASH_USERNAME=siriusharrison

# 飞书机器人 Webhook - 摄影师日报推送
# 获取方式: 飞书管理后台 → 机器人 → 创建 → 复制 Webhook 地址
FEISHU_WEBHOOK_PHOTOGRAPHER=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx

# ========== 小秘书 Agent (agents/secretary) ==========
# 飞书机器人 Webhook - 小秘书日报推送
# 获取方式: 飞书管理后台 → 机器人 → 创建 → 复制 Webhook 地址
FEISHU_WEBHOOK_SECRETARY=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx

# GitHub Token - 用于访问私有 claude-config 仓库
# 获取方式: https://github.com/settings/tokens/new
# 权限: repo (完整仓库访问)
# 过期: No expiration (永久有效)
CONFIG_REPO_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== 知识管理 Agent (agents/knowledge-keeper) ==========
# 飞书应用 ID
# 获取方式: 飞书后台 → 应用管理 → 创建应用 → App ID
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxxxxx

# 飞书应用 Secret
# 获取方式: 飞书后台 → 应用管理 → 创建应用 → App Secret
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxx

# GitLab Personal Access Token
# 获取方式: https://gitlab.paigod.work/-/profile/personal_access_tokens
# 权限: api, read_api, read_repository
GITLAB_TOKEN=xxx_xxxxxxxxxxxxxxxxxxxxx

# Notion API Key
# 获取方式: https://www.notion.so/my-integrations
# 格式: ntn_xxxxxxxxxxxxxxxxxxxxxx
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxx

# Notion Database ID
# 获取方式: 打开 Notion 数据库，从 URL 复制 ID
# 格式: xxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
