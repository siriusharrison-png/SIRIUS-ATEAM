# 海报设计师需要的环境变量
# 复制为 .env 并填入真实值，或直接 export 到 shell
# 通过 OpenAI 兼容网关的 Images API 调用 gpt-image-2 出图

# 网关 API Key（图生图必需）
GATEWAY_API_KEY=your_gateway_api_key_here

# 网关地址（OpenAI 兼容 endpoint，以 /v1 结尾）
GATEWAY_BASE_URL=https://apiproxy.paigod.work/v1

# 模型名：网关把 gpt-image-2 拆成两个独立模型，代码已分别默认：
#   图生图（拖图出海报）→ gpt-image-2-edit
#   文生图（无参考图）  → gpt-image-2-text-to-image
# 一般无需设置。如需覆盖：
# POSTER_MODEL=          # 设了则同时覆盖两条路径（整体兜底）
# POSTER_MODEL_EDIT=gpt-image-2-edit
# POSTER_MODEL_GENERATE=gpt-image-2-text-to-image

# 可选：出图尺寸（默认 1024x1536 竖版，最接近 zine 3:5）
# POSTER_SIZE=1024x1536

