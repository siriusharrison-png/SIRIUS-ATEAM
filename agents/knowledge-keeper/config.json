{
  "name": "知识管理",
  "role": "specialist",
  "description": "学习知识收集与管理 + 飞书文档和 GitLab 同步",
  "capabilities": [
    "knowledge_add",
    "notion_sync",
    "feishu_docs_sync",
    "gitlab_workspace_sync",
    "weekly_summary"
  ],
  "triggers": [
    "/learn",
    "/weekly",
    "加入知识库",
    "加入待学清单",
    "学习这个概念"
  ],
  "dataSources": [
    {
      "type": "feishu",
      "url": "https://ppio-cloud.feishu.cn/wiki/BW3ZwOSQZiHWGuk96wVcPRhynJb",
      "schedule": "daily",
      "time": "08:00"
    },
    {
      "type": "gitlab",
      "url": "https://gitlab.paigod.work/product-agent/product_workspace/-/tree/main/knowledge/ux-dx-ax",
      "schedule": "on_push",
      "fallback_time": "12:00"
    }
  ],
  "inputFrom": [
    "hub.json",
    "user_input",
    "feishu_wiki",
    "gitlab_workspace"
  ],
  "outputTo": [
    "hub.json",
    "Notion",
    "knowledge-list.md"
  ],
  "reportTo": "小秘书"
}
