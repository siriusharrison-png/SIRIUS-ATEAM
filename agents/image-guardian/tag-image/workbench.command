#!/bin/bash
# 图片打标签 · 工作台
# 双击本文件 → 起本地服务并自动打开浏览器 → 拖入照片，自动出标签。
# 关掉这个终端窗口即停止服务。

cd "$(dirname "$0")" || exit 1

echo "──────────────────────────────────"
echo "  图片打标签 · 工作台启动中…"
echo "──────────────────────────────────"
echo "浏览器会自动打开。把照片拖进去即可出标签。"
echo "关闭本窗口即停止服务。"
echo ""

python3 scripts/serve.py

echo ""
read -r -p "服务已停止，按回车关闭…" _
